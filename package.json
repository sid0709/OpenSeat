{
  "name": "openseat",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "openseat-frontend",
    "openseat-theme",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint packages/design-system --max-warnings=0",
    "lint:fix": "eslint packages/design-system --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "prettier --write",
    "**/*.{json,css,scss,md,mdx,yml,yaml}": "prettier --write"
  }
}
